# ──────────────────────────────────────
# Environment Configuration Example
# ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# Frontend (Vite) — required for dev server
VITE_GITHUB_URL=https://nightguarder.github.io/Vue-Education-Materials/manifest.json
VITE_OMLX_PORT=8888
VITE_OMLX_API_KEY=your-omlx-api-key
VITE_DEFAULT_MODEL=gemma-4-e4b-it-OptiQ-4bit
VITE_TAVILY_API_KEY=your-tavily-api-key

# Backend - Local Database (Docker MySQL on port 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=
DB_NAME_EDUCATION=education_patients
DB_NAME_ACCOUNTS=stegerova_accounts
